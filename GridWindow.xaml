<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      Background="#181818" TextOptions.TextFormattingMode="Display">
  <Grid.Resources>
    <!-- タイルの大きさ (小・中・大。コードから変える) -->
    <sys:Double x:Key="TileW">160</sys:Double>
    <sys:Double x:Key="TileH">120</sys:Double>

    <Style x:Key="SizeTgl" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="#EEEEEE"/>
      <Setter Property="Background" Value="#3A3A3A"/>
      <Setter Property="Padding" Value="10,1"/>
      <Setter Property="Margin" Value="2,3"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#505050"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E0A000"/>
                <Setter Property="Foreground" Value="#111111"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GridItem" TargetType="ListBoxItem">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Margin="3" Padding="4" CornerRadius="4" Background="Transparent"
                    BorderThickness="2" BorderBrush="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#303030"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#E0A000"/>
                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
              </Trigger>
              <!-- メイン画面に表示中の項目は、太く明るい枠 (太くした分だけ余白を減らして大きさは変えない) -->
              <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFE84D"/>
                <Setter TargetName="Bd" Property="BorderThickness" Value="4"/>
                <Setter TargetName="Bd" Property="Padding" Value="2"/>
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>

  <Grid.RowDefinitions>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <ListBox x:Name="GridList" Background="#181818" BorderThickness="0" Padding="4"
           IsSynchronizedWithCurrentItem="False"
           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
           ScrollViewer.VerticalScrollBarVisibility="Auto"
           ItemContainerStyle="{StaticResource GridItem}">
    <ListBox.ItemsPanel>
      <ItemsPanelTemplate>
        <WrapPanel Orientation="Horizontal"/>
      </ItemsPanelTemplate>
    </ListBox.ItemsPanel>
    <ListBox.ItemTemplate>
      <DataTemplate>
        <StackPanel Width="{DynamicResource TileW}" ToolTip="{Binding FileName}">
          <Grid Width="{DynamicResource TileW}" Height="{DynamicResource TileH}" Background="#0C0C0C">
            <Image Source="{Binding GridImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Border Visibility="{Binding VideoMark}" Background="#AA000000" CornerRadius="3" Padding="5,1,4,2"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="3">
              <TextBlock Text="&#x25B6;" FontFamily="Segoe UI Symbol" Foreground="#FFFFFF" FontSize="11"/>
            </Border>
          </Grid>
          <TextBlock Text="{Binding Stars}" Foreground="#FFC107" FontSize="15" HorizontalAlignment="Center" Margin="0,3,0,0"/>
          <TextBlock Text="{Binding FileName}" Foreground="#AAAAAA" FontSize="11"
                     TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
        </StackPanel>
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>

  <DockPanel Grid.Row="1" Background="#2B2B2B">
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="8,0,4,0" VerticalAlignment="Center">
      <TextBlock Text="大きさ" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
      <ToggleButton x:Name="SizeSmall" Content="小" Style="{StaticResource SizeTgl}"/>
      <ToggleButton x:Name="SizeMedium" Content="中" Style="{StaticResource SizeTgl}"/>
      <ToggleButton x:Name="SizeLarge" Content="大" Style="{StaticResource SizeTgl}"/>
    </StackPanel>
    <TextBlock x:Name="GridCountText" DockPanel.Dock="Right" Foreground="#DDDDDD" Margin="10,4" FontSize="12"/>
    <TextBlock x:Name="GridLoadText" DockPanel.Dock="Right" Foreground="#999999" Margin="10,4" FontSize="11"
               VerticalAlignment="Center" Visibility="Collapsed"/>
    <TextBlock Foreground="#AAAAAA" Margin="10,4" FontSize="12" TextTrimming="CharacterEllipsis"
               Text="クリック: 表示・再生 / Ctrl・Shift+クリック: 複数選択 / Ctrl+D: 複数選択を解除 /ダブルクリック・Enter: メインウインドウへ / 1〜5: 評価 / Del: 削除 / Ctrl+ホイール: 大きさ / Esc: 閉じる"/>
  </DockPanel>
</Grid>
