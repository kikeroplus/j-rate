<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Margin="18,14,18,16" TextOptions.TextFormattingMode="Display">
  <Grid.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#DDDDDD"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="#EEEEEE"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="0,10,0,6"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="4,3"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="14,4"/>
      <Setter Property="MinWidth" Value="80"/>
    </Style>
  </Grid.Resources>

  <StackPanel>
    <TextBlock x:Name="HeaderText" FontSize="14" Foreground="#FFC107" TextWrapping="Wrap" Margin="0,0,0,4"/>

    <!-- 既存のフォルダ -->
    <RadioButton x:Name="ExistingRadio" GroupName="Dest" Content="既存のフォルダを使う"/>
    <DockPanel Margin="22,0,0,0" IsEnabled="{Binding IsChecked, ElementName=ExistingRadio}">
      <Button x:Name="BrowseExisting" Content="参照..." DockPanel.Dock="Right" Margin="6,0,0,0"/>
      <TextBox x:Name="ExistingPath"/>
    </DockPanel>

    <!-- 新しいフォルダ -->
    <RadioButton x:Name="NewRadio" GroupName="Dest" Content="新しいフォルダを作る" Margin="0,16,0,6"/>
    <Grid Margin="22,0,0,0" IsEnabled="{Binding IsChecked, ElementName=NewRadio}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Text="作成場所" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <TextBox x:Name="ParentPath" Grid.Column="1"/>
      <Button x:Name="BrowseParent" Grid.Column="2" Content="参照..." Margin="6,0,0,0"/>
      <TextBlock Grid.Row="1" Text="フォルダ名" VerticalAlignment="Center" Margin="0,6,10,0"/>
      <TextBox x:Name="NewName" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"/>
    </Grid>

    <!-- 同名ファイル -->
    <TextBlock Text="同じ名前のファイルが既にある場合 (サイズとチェックサムで中身を比較します)" Margin="0,20,0,6"/>
    <Grid Margin="22,0,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Text="中身が同じ" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <ComboBox x:Name="IdenticalBox" Grid.Column="1" FontSize="13" Padding="6,3">
        <ComboBoxItem Content="スキップする (何もしない)"/>
        <ComboBoxItem Content="上書きする"/>
      </ComboBox>
      <TextBlock Grid.Row="1" Text="中身が違う" VerticalAlignment="Center" Margin="0,6,10,0"/>
      <ComboBox x:Name="ConflictBox" Grid.Row="1" Grid.Column="1" FontSize="13" Padding="6,3" Margin="0,6,0,0">
        <ComboBoxItem Content="番号を付けて別名で保存 (例: IMG_0001 (2).jpg)"/>
        <ComboBoxItem Content="スキップする"/>
        <ComboBoxItem Content="上書きする"/>
      </ComboBox>
    </Grid>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button x:Name="OkButton" IsDefault="True" Margin="0,0,8,0"/>
      <Button x:Name="CancelButton" Content="キャンセル" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Grid>
