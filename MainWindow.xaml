<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#202020" TextOptions.TextFormattingMode="Display">
  <Grid.Resources>
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="#EEEEEE"/>
      <Setter Property="Background" Value="#3A3A3A"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="Margin" Value="2,3"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#505050"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#626262"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Tgl" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="#EEEEEE"/>
      <Setter Property="Background" Value="#3A3A3A"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="Margin" Value="2,3"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="MinWidth" Value="48"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#505050"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#E0A000"/>
                <Setter Property="Foreground" Value="#111111"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ThumbItem" TargetType="ListBoxItem">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Margin="3" Padding="4" CornerRadius="4" Background="Transparent"
                    BorderThickness="2" BorderBrush="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#303030"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#E0A000"/>
                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- フォルダツリー用 -->
    <Style x:Key="TreeExpander" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="Transparent" Width="18" Height="20">
              <Path x:Name="Arrow" Data="M 6,5 L 11,10 L 6,15" Stroke="#999999" StrokeThickness="1.5"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Arrow" Property="Data" Value="M 4,7 L 9,12 L 14,7"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Arrow" Property="Stroke" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TreeViewItem">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
      <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
      <Setter Property="Foreground" Value="#DDDDDD"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TreeViewItem">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
              </Grid.RowDefinitions>
              <ToggleButton x:Name="Expander" Style="{StaticResource TreeExpander}" ClickMode="Press"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
              <Border x:Name="Bd" Grid.Column="1" Padding="4,3,8,3" CornerRadius="3" Background="Transparent"
                      HorizontalAlignment="Left" Cursor="Hand">
                <ContentPresenter x:Name="PART_Header" ContentSource="Header"/>
              </Border>
              <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="False">
                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
              </Trigger>
              <Trigger Property="HasItems" Value="False">
                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
              </Trigger>
              <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#333333"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#7A5C00"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>

  <Grid.ColumnDefinitions>
    <ColumnDefinition x:Name="TreeColumn" Width="250"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="*" MinWidth="320"/>
  </Grid.ColumnDefinitions>
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <!-- ツールバー -->
  <Border x:Name="Toolbar" Grid.Row="0" Grid.ColumnSpan="3" Background="#2B2B2B" Padding="8,3">
    <WrapPanel Orientation="Horizontal">
      <Button x:Name="OpenButton" Content="フォルダを開く" Style="{StaticResource Btn}"/>
      <Button x:Name="GridButton" Content="グリッド一覧" Style="{StaticResource Btn}" ToolTip="表示中の画像・動画を別ウインドウに一覧表示 (Ctrl+G)"/>
      <Button x:Name="GenerateButton" Content="生成する" Style="{StaticResource Btn}" ToolTip="表示している画像から ComfyUI で動画や画像を生成"/>
      <Button x:Name="JobsButton" Content="生成ジョブ" Style="{StaticResource Btn}" ToolTip="ComfyUI での生成の進み具合を一覧表示・キャンセル (Ctrl+J)"/>
      <Button x:Name="ComfySettingsButton" Content="生成の設定" Style="{StaticResource Btn}" ToolTip="ComfyUI の接続先・ワークフロー・プロンプトのプリセットの登録や並び替え、エクスポート・インポート"/>
      <Rectangle Width="1" Fill="#555555" Margin="10,6"/>
      <TextBlock Text="フィルター" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
      <ToggleButton x:Name="F1" Content="★1" Style="{StaticResource Tgl}"/>
      <ToggleButton x:Name="F2" Content="★2" Style="{StaticResource Tgl}"/>
      <ToggleButton x:Name="F3" Content="★3" Style="{StaticResource Tgl}"/>
      <ToggleButton x:Name="F4" Content="★4" Style="{StaticResource Tgl}"/>
      <ToggleButton x:Name="F5" Content="★5" Style="{StaticResource Tgl}"/>
      <Rectangle Width="1" Fill="#555555" Margin="10,6"/>
      <ToggleButton x:Name="ModeAtLeast" Content="以上" Style="{StaticResource Tgl}"/>
      <ToggleButton x:Name="ModeAtMost" Content="以下" Style="{StaticResource Tgl}"/>
      <ToggleButton x:Name="ModeOnly" Content="のみ" Style="{StaticResource Tgl}"/>
      <Rectangle Width="1" Fill="#555555" Margin="10,6"/>
      <ToggleButton x:Name="TypeImage" Content="画像のみ表示" Style="{StaticResource Tgl}" ToolTip="画像だけを表示 (もう一度押すと解除)"/>
      <ToggleButton x:Name="TypeVideo" Content="動画のみ表示" Style="{StaticResource Tgl}" ToolTip="動画だけを表示 (もう一度押すと解除)"/>
      <Rectangle Width="1" Fill="#555555" Margin="10,6"/>
      <Button x:Name="FilterAll" Content="すべて表示" Style="{StaticResource Btn}"/>
      <Rectangle Width="1" Fill="#555555" Margin="10,6"/>
      <Button x:Name="CopyButton" Content="表示中をコピー..." Style="{StaticResource Btn}" ToolTipService.ShowOnDisabled="True"
              ToolTip="サムネール一覧に表示中の画像をすべて別のフォルダにコピー (★フィルター選択時のみ)"/>
      <Button x:Name="MoveButton" Content="表示中を移動..." Style="{StaticResource Btn}" ToolTipService.ShowOnDisabled="True"
              ToolTip="サムネール一覧に表示中の画像をすべて別のフォルダに移動 (★フィルター選択時のみ)"/>
      <Rectangle Width="1" Fill="#555555" Margin="10,6"/>
      <TextBlock Text="並び順" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
      <ComboBox x:Name="SortBox" Width="150" VerticalAlignment="Center" Focusable="False" FontSize="13">
        <ComboBoxItem Content="名前 (昇順)"/>
        <ComboBoxItem Content="名前 (降順)"/>
        <ComboBoxItem Content="更新日時 (古い順)"/>
        <ComboBoxItem Content="更新日時 (新しい順)"/>
      </ComboBox>
      <CheckBox x:Name="AutoNext" Content="評価後に次へ" Foreground="#DDDDDD" VerticalAlignment="Center"
                Margin="14,0,0,0" Focusable="False" FontSize="13"/>
    </WrapPanel>
  </Border>

  <!-- フォルダツリー -->
  <TreeView x:Name="FolderTree" Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Background="#1C1C1C"
            BorderThickness="0" Foreground="#DDDDDD" FontSize="13" Padding="2,6,0,6"
            ScrollViewer.HorizontalScrollBarVisibility="Auto">
    <TreeView.ItemTemplate>
      <HierarchicalDataTemplate ItemsSource="{Binding Children}">
        <StackPanel Orientation="Horizontal" Opacity="{Binding Opacity}">
          <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
        </StackPanel>
      </HierarchicalDataTemplate>
    </TreeView.ItemTemplate>
  </TreeView>
  <GridSplitter Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Width="5" Background="#2B2B2B"
                HorizontalAlignment="Center" VerticalAlignment="Stretch" Focusable="False"/>

  <!-- メイン画像 -->
  <Grid Grid.Row="1" Grid.Column="2" Background="#111111">
  <Grid.RowDefinitions>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <!-- 動画の操作バー (動画を表示中だけ) -->
  <Border x:Name="VideoBar" Grid.Row="1" Background="#262626" Padding="8,4" Visibility="Collapsed">
    <DockPanel>
      <Button x:Name="PlayButton" DockPanel.Dock="Left" Style="{StaticResource Btn}" Width="40" Padding="0,4"
              FontFamily="Segoe UI Symbol" Content="&#x25B6;" ToolTip="再生 / 一時停止 (Space)"/>
      <Button x:Name="MuteButton" DockPanel.Dock="Right" Style="{StaticResource Btn}" Width="40" Padding="0,4"
              FontFamily="Segoe UI Symbol" Content="&#x1F50A;" ToolTip="消音"/>
      <Slider x:Name="VolumeSlider" DockPanel.Dock="Right" Width="90" Minimum="0" Maximum="1" Value="0.5"
              VerticalAlignment="Center" Focusable="False" IsMoveToPointEnabled="True" ToolTip="音量"/>
      <TextBlock x:Name="TimeText" DockPanel.Dock="Right" Foreground="#DDDDDD" FontSize="13" Margin="10,0,14,0"
                 VerticalAlignment="Center" Text="0:00 / 0:00"/>
      <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="10,0,0,0"
              Focusable="False" IsMoveToPointEnabled="True"/>
    </DockPanel>
  </Border>
  <Grid x:Name="MainArea" Background="#111111" ClipToBounds="True">
    <!-- 動画は画像の下。切り替え中は MainImage に前の絵を出しておき、動画の最初のフレームが描かれてから消す -->
    <MediaElement x:Name="MainVideo" Stretch="Uniform" Margin="8" LoadedBehavior="Manual" UnloadedBehavior="Close"
                  ScrubbingEnabled="False" Opacity="0" IsHitTestVisible="False"/>
    <Image x:Name="MainImage" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality"/>
    <TextBlock x:Name="EmptyText" Foreground="#777777" FontSize="18" TextAlignment="Center"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Text="「フォルダを開く」(Ctrl+O) か、ここにフォルダ / 画像をドロップしてください"/>
    <Border x:Name="RatingBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14"
            Background="#AA000000" CornerRadius="6" Padding="14,2,14,6" Visibility="Collapsed">
      <StackPanel x:Name="StarPanel" Orientation="Horizontal" Background="Transparent" ToolTip="クリックで評価 (同じ星をもう一度クリックで解除)"/>
    </Border>
    <Border x:Name="InfoBadge" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14"
            Background="#AA000000" CornerRadius="6" Padding="10,4" Visibility="Collapsed">
      <TextBlock x:Name="InfoText" FontSize="13" Foreground="#DDDDDD"/>
    </Border>
  </Grid>
  </Grid>

  <!-- サムネール一覧 -->
  <ListBox x:Name="ThumbList" Grid.Row="2" Grid.Column="2" Height="172" Background="#181818" BorderThickness="0"
           ScrollViewer.HorizontalScrollBarVisibility="Auto"
           ScrollViewer.VerticalScrollBarVisibility="Disabled"
           VirtualizingPanel.IsVirtualizing="True"
           VirtualizingPanel.VirtualizationMode="Recycling"
           ItemContainerStyle="{StaticResource ThumbItem}">
    <ListBox.ItemsPanel>
      <ItemsPanelTemplate>
        <VirtualizingStackPanel Orientation="Horizontal"/>
      </ItemsPanelTemplate>
    </ListBox.ItemsPanel>
    <ListBox.ItemTemplate>
      <DataTemplate>
        <StackPanel Width="128">
          <Grid Width="128" Height="96" Background="#0C0C0C">
            <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Border Visibility="{Binding VideoMark}" Background="#AA000000" CornerRadius="3" Padding="5,1,4,2"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="3">
              <TextBlock Text="&#x25B6;" FontFamily="Segoe UI Symbol" Foreground="#FFFFFF" FontSize="11"/>
            </Border>
          </Grid>
          <TextBlock Text="{Binding Stars}" Foreground="#FFC107" FontSize="15" HorizontalAlignment="Center" Margin="0,3,0,0"/>
          <TextBlock Text="{Binding FileName}" Foreground="#AAAAAA" FontSize="11"
                     TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
        </StackPanel>
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>

  <!-- ステータスバー -->
  <DockPanel Grid.Row="3" Grid.ColumnSpan="3" Background="#2B2B2B">
    <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="#DDDDDD" Margin="10,4" FontSize="12"/>
    <!-- 読み込みインジケータ (読み込み中だけ表示) -->
    <StackPanel x:Name="LoadPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                Margin="10,0" Visibility="Collapsed">
      <TextBlock x:Name="LoadText" Foreground="#999999" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <ProgressBar x:Name="LoadBar" Width="110" Height="4" VerticalAlignment="Center" BorderThickness="0"
                   Foreground="#E0A000" Background="#454545"/>
    </StackPanel>
    <TextBlock x:Name="StatusText" Foreground="#AAAAAA" Margin="10,4" FontSize="12" TextTrimming="CharacterEllipsis"/>
  </DockPanel>
</Grid>
